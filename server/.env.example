# Serveur
PORT=40007
CLIENT_ORIGIN=http://localhost:40071

# Auth
JWT_SECRET=change-me-super-secret
# Cle dediee au chiffrement des secrets tiers (jetons Modrinth) au repos.
# Si absente, JWT_SECRET est utilise.
TOKEN_SECRET=change-me-too

# Base de donnees
DB_PATH=data/app.db

# Autocompletion IA (Groq)
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Quota de tokens par utilisateur et par jour (modifiable)
AI_QUOTA_TOKENS=5000

# API Modrinth (laisser vide en production : https://api.modrinth.com/v2)
# MODRINTH_API_BASE=https://api.modrinth.com/v2
# User-Agent envoye a Modrinth (version applicative)
APP_VERSION=1.1.0
